{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    // Some lib modules import each other with explicit extensions so their
    // coordinators stay runnable under `node --test`.
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "types": ["svelte"]
  },
  "exclude": ["src/**/*.test.ts"]
}
