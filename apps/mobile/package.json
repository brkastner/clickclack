{
  "name": "@clickclack/mobile",
  "version": "0.0.0",
  "private": true,
  "author": "OpenClaw contributors",
  "description": "Native ClickClack mobile shell for iOS and Android",
  "homepage": "https://clickclack.chat",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "add:android": "cap add android && pnpm configure:native",
    "add:ios": "cap add ios && pnpm configure:native",
    "configure:native": "node scripts/configure-native.mjs",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "sync": "cap sync && pnpm configure:native",
    "test": "node --test scripts/*.test.mjs src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
